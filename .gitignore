# =========================================================
# EXCEPTION RULES (DO NOT IGNORE THESE FILES)
# =========================================================

# Force include important files even if matching rules above
!.gitignore
!.gitkeep
!README.md
!requirements.txt
!package.json
!setup.py
!setup.cfg

# Keep documentation and example files
!.env.example
!.env.sample
!config.example.py
!config.example.yml
!docs/
!docs/**/*.md

# Keep source code
!phase1/**/*.py
!phase2/**/*.py
!phase3/**/*.py
!phase3/**/*.yml
!phase4/**/*.py
!phase4/**/*.json
!phase5/src/**/*.jsx
!phase5/src/**/*.js
!phase5/src/**/*.jsx
